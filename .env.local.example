# Copy to .env.local and fill in values. .env.local is git-ignored.

# --- Supabase (required) ---
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App URL (required) ---
# Used by magic-link redirects and email links. Match your dev port (3300).
NEXT_PUBLIC_APP_URL=http://localhost:3300

# --- Cron gate (required in production, optional in dev) ---
# Any long random string. Vercel Cron sends it as Authorization: Bearer <this>.
CRON_SECRET=change-me-to-a-long-random-string

# --- Anthropic (only needed to test /coach in Phase 2) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Resend (only needed to actually deliver invite / nudge / digest emails) ---
# Without this the app logs email content to the server console instead of sending.
# RESEND_API_KEY=re_...
# RESEND_FROM="BRAVE MAN OS <noreply@your-domain.com>"

# --- ITC Map Builder (ad-hoc addition for Boardroom) ---
# Set to 1 to expose /itc routes. When unset, /itc/* returns 404.
# ITC_DEMO_AUTH=1
# Long random string (>= 32 chars). Used to HMAC-sign the itc_session cookie.
# Rotate to invalidate all existing ITC sessions.
# ITC_SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Anthropic model IDs (both REQUIRED — no hardcoded fallbacks) ---
# Two tiers, no more knobs than necessary. Set both to a currently-valid
# Anthropic model id. If you want to run everything on the same model,
# set them equal.
#
# We deliberately don't ship fallback strings: when a model is deprecated
# we want a loud "env var missing" error at first use, not a silent
# switch to a stale default that fails opaquely at the API.

# Conversational tier — main coach turns (ITC + non-ITC). Sonnet-class
# recommended for quality.
ANTHROPIC_MODEL=claude-sonnet-5

# Utility tier — depth rubrics, post-turn reconciliation, safety
# classifier, scenario-test judge. Runs 3-5x per coach turn, so Haiku-class
# keeps cost/latency down.
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5-20251001

# --- ITC prompt caching (optional) ---
# Enables Anthropic ephemeral prompt caching on the coach + extractor
# system prompts. Cache-read is 10% of input cost, cache-write is 125%
# — break-even after ~3 reads within the 5-minute TTL. Turns in a
# single coaching session almost always hit the cache. Anthropic
# dashboard "prompt cache hit rate" panel shows the actual savings.
# Set to 1 / true / yes / on to enable. Leave unset (or 0) to disable.
# Safe to toggle — cache hits return byte-for-byte identical output;
# no functional risk from enabling.
# ITC_PROMPT_CACHE=1
