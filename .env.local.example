# Copy to .env.local and fill in values. .env.local is git-ignored.

# --- Supabase (required) ---
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App URL (required) ---
# Used by magic-link redirects and email links. Match your dev port (3300).
NEXT_PUBLIC_APP_URL=http://localhost:3300

# --- Cron gate (required in production, optional in dev) ---
# Any long random string. Vercel Cron sends it as Authorization: Bearer <this>.
CRON_SECRET=change-me-to-a-long-random-string

# --- Anthropic (only needed to test /coach in Phase 2) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Resend (only needed to actually deliver invite / nudge / digest emails) ---
# Without this the app logs email content to the server console instead of sending.
# RESEND_API_KEY=re_...
# RESEND_FROM="BRAVE MAN OS <noreply@your-domain.com>"

# --- ITC Map Builder (ad-hoc addition for Boardroom) ---
# Set to 1 to expose /itc routes. When unset, /itc/* returns 404.
# ITC_DEMO_AUTH=1
# Long random string (>= 32 chars). Used to HMAC-sign the itc_session cookie.
# Rotate to invalidate all existing ITC sessions.
# ITC_SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Anthropic model IDs (all REQUIRED — no hardcoded fallbacks) ---
# We deliberately don't ship fallback model ids: when a model is deprecated
# we want a loud "env var missing" error at first use, not a silent switch
# to a stale default that fails opaquely at the API. Set each to a
# currently-valid Anthropic model id.

# Main ITC coach — Sonnet-class recommended.
ITC_COACH_MODEL=claude-sonnet-5

# Depth rubrics (worry / commitment / assumption) — Haiku-class is fine.
ITC_RUBRIC_MODEL=claude-haiku-4-5-20251001

# Post-turn reconciliation pass that catches state changes the coach's
# reply implied but didn't fire as an action. Runs once per coach turn.
# Haiku-class recommended.
ITC_RECONCILE_MODEL=claude-haiku-4-5

# Scenario-test LLM judge (semantic assertions on coach replies). Only
# used by the vitest scenarios suite, not the running app.
ITC_TEST_JUDGE_MODEL=claude-haiku-4-5-20251001

# --- Primary (non-ITC) coach model IDs (REQUIRED if you use /coach) ---
PRIMARY_COACH_MODEL=claude-sonnet-4-6
PRIMARY_HAIKU_MODEL=claude-haiku-4-5
